{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiscalgeometry.com/schemas/rael/geep-v1.0.schema.json",
  "title": "RAEL Governed Execution Evidence Package",
  "description": "Machine-readable evidence package for reconstructing the formation, authorization, execution, verification and closure of a RAEL accounting event.",
  "type": "object",

  "required": [
    "geep_version",
    "source_event_id",
    "event_type",
    "candidate_objects",
    "evidence",
    "execution_policy",
    "route",
    "proposed_action",
    "pre_state",
    "verification",
    "closure_status"
  ],

  "properties": {
    "geep_version": {
      "type": "string",
      "const": "1.0"
    },

    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier of the admitted source economic event."
    },

    "event_type": {
      "type": "string",
      "minLength": 1,
      "description": "Accounting event type, for example ar_payment."
    },

    "timestamps": {
      "type": "object",
      "properties": {
        "admitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "classified_at": {
          "type": "string",
          "format": "date-time"
        },
        "routed_at": {
          "type": "string",
          "format": "date-time"
        },
        "executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "closed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },

    "actor": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "actor_type": {
          "type": "string",
          "enum": [
            "system",
            "human",
            "service"
          ]
        },
        "authority_profile": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "system": {
      "type": "object",
      "properties": {
        "system_id": {
          "type": "string"
        },
        "adapter": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "candidate_objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "id"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },

    "evidence": {
      "type": "object",
      "required": [
        "supporting",
        "conflicting",
        "missing"
      ],
      "properties": {
        "supporting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicting": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },

    "execution_policy": {
      "type": "object",
      "required": [
        "rule_version",
        "evidence_sufficient",
        "rule_determinate",
        "risk_tier",
        "delegated_authority",
        "post_action_verifiable"
      ],
      "properties": {
        "rule_version": {
          "type": "string"
        },
        "evidence_sufficient": {
          "type": "boolean"
        },
        "rule_determinate": {
          "type": "boolean"
        },
        "risk_tier": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "materiality_trigger": {
          "type": "boolean"
        },
        "delegated_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "post_action_verifiable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },

    "route": {
      "type": "string",
      "enum": [
        "BSTP",
        "ASLTP_REVIEW",
        "EVIDENCE_REQUEST",
        "REJECTED"
      ]
    },

    "escalation": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "trigger": {
          "type": "string"
        },
        "unresolved_question": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "proposed_action": {
      "type": "object",
      "description": "Action proposed before execution.",
      "additionalProperties": true
    },

    "authorized_action": {
      "type": "object",
      "description": "Action actually authorized for execution.",
      "additionalProperties": true
    },

    "pre_state": {
      "type": "object",
      "description": "Relevant accounting state immediately before execution.",
      "additionalProperties": true
    },

    "execution_response": {
      "type": "object",
      "description": "Technical acknowledgement returned by the execution interface. This does not by itself establish closure.",
      "additionalProperties": true
    },

    "observed_post_state": {
      "type": "object",
      "description": "Freshly re-read accounting state following execution.",
      "additionalProperties": true
    },

    "verification": {
      "type": "object",
      "required": [
        "status",
        "tests"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "passed",
            "failed",
            "conditional"
          ]
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },

    "human_review": {
      "type": "object",
      "properties": {
        "question_presented": {
          "type": "string"
        },
        "evidence_considered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decision": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "reviewer_authority": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "exception_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },

    "integrity": {
      "type": "object",
      "properties": {
        "record_hash": {
          "type": "string"
        },
        "previous_record_hash": {
          "type": "string"
        },
        "policy_hash": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },

    "reversal_of": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identifier of the earlier transition being reversed or corrected."
    },

    "closure_status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "verified_closed",
        "conditionally_closed",
        "escalated",
        "evidence_required",
        "rejected",
        "reopened",
        "reversed"
      ]
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "closure_status": {
            "const": "verified_closed"
          }
        }
      },
      "then": {
        "required": [
          "observed_post_state"
        ],
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      }
    },

    {
      "if": {
        "properties": {
          "route": {
            "const": "BSTP"
          }
        }
      },
      "then": {
        "properties": {
          "execution_policy": {
            "properties": {
              "evidence_sufficient": {
                "const": true
              },
              "rule_determinate": {
                "const": true
              },
              "post_action_verifiable": {
                "const": true
              }
            }
          }
        }
      }
    }
  ],

  "additionalProperties": false
}
